# Lab settings. Copied to .env automatically when your Codespace is created.
# .env is never committed to git.

# Poly Lens: paste the client ID and Client secret shared in the Seat Key CSV
# (no credentials? set LENS_MOCK=1 to use built-in sample data)
LENS_MOCK=0
POLY_LENS_CLIENT_ID=
POLY_LENS_CLIENT_SECRET=

# Safety settings for Module 5
LAB_MODE=simulate
LAB_ALLOWED_DEVICE_IDS=

# Who to ask for help (shown in error messages)
LAB_HOST_NAME=Daniel

# AI model access (Modules 4-5)
# In the lab: the gateway URL below is already set; paste the key from your seat card.
LAB_LLM_BASE_URL=https://miniature-guide-jjvg9jx469vc59p6-8080.app.github.dev/v1
LAB_LLM_API_KEY=

# After the lab, with your own Anthropic API key instead:
#   LAB_LLM_BASE_URL=https://api.anthropic.com/v1
#   LAB_LLM_API_KEY=<your Anthropic API key>
#   LAB_MODEL=claude-haiku-5-5